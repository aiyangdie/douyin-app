# Fonts copied from the host by tools/gen_videos.py (see tools/README.md)
tools/fonts/

# Backend runtime data: the SQLite database plus media copied in by `seed.js`
# and uploaded through the app. Regenerated with `npm run server:seed`.
server/data/
server/uploads/

# Expo's template MIT licence, attributing "Copyright (c) 2015-present 650
# Industries, Inc." to this project's code. Left on disk but deliberately not
# published; add your own licence before making the repo official.
LICENSE

# Partial backups of node_modules (e.g. `node_modules.before-repair-*`), left
# behind by external repair steps. ESLint and TypeScript only auto-ignore the
# literal `node_modules` directory, so anything merely *starting* with that name
# still gets compiled and linted — keep them out of the repo and out of the build.
node_modules.*/
